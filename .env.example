# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# The password for /admin. Locally it defaults to "admin" when unset.
ADMIN_PASSWORD=

# Optional but recommended: a long random string. Signs the admin cookie and
# encrypts the stored Claude API key. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Postgres. Vercel sets this when you connect a Neon database from the
# Storage tab. Locally, leave it empty to use a built-in database in .data/.
DATABASE_URL=
